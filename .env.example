# Copy to .env and fill in. Environment variables win over this file.
# CLI options (--base-url, --api-key, --embed-base-url, ...) win over both.

# --- LLM (required) ---
# OpenAI-compatible endpoint, e.g. http://127.0.0.1:8080/v1 (llama.cpp / vLLM / LM Studio)
BASE_URL=
API_KEY=
MODEL=

# --- Embedding (only with `mark --retrieve`) ---
# EMBED_BASE_URL / EMBED_API_KEY fall back to BASE_URL / API_KEY when empty.
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
# Optional task prefixes; default to the model's own (known for embeddinggemma).
# EMBED_QUERY_PREFIX=
# EMBED_DOC_PREFIX=

# --- Rerank (optional, with `mark --retrieve`) ---
# Without RERANK_MODEL, passages are ranked by embedding similarity only.
# RERANK_BASE_URL / RERANK_API_KEY fall back to BASE_URL / API_KEY when empty.
RERANK_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
